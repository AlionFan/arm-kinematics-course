<Slide style={{ width: 1280, height: 720, padding: 0, display: 'flex', flexDirection: 'column', background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ height: 76, background: '#1E4FA8', display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>预测—验证：扫描 θ₂，看 r 怎么变</Text>
        <Text style={{ fontSize: 15, color: '#CFE0F5' }}>M3 · 探究实验</Text>
    </Box>
    <Box style={{ height: 12 }} />
    <Box style={{ flex: 1, paddingLeft: 40, paddingRight: 40, display: 'flex', flexDirection: 'column', gap: 12 }}>
        <Box style={{ height: 46, background: '#E8EFF8', display: 'flex', alignItems: 'center', paddingLeft: 18 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>固定 θ₁ = 0°，让 θ₂ 从 0° 扫到 180°：末端到原点的距离 r 会怎么变？</Text>
        </Box>
        <Box style={{ height: 296, background: '#FFFFFF', border: '1px solid #E8EFF8', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
            <svg width={700} height={286} viewBox='0 0 700 286'>
                <line x1='110' y1='220' x2='640' y2='220' stroke='#E8EFF8' strokeWidth='1' />
                <line x1='110' y1='180' x2='640' y2='180' stroke='#E8EFF8' strokeWidth='1' />
                <line x1='110' y1='140' x2='640' y2='140' stroke='#E8EFF8' strokeWidth='1' />
                <line x1='110' y1='100' x2='640' y2='100' stroke='#E8EFF8' strokeWidth='1' />
                <line x1='110' y1='60' x2='640' y2='60' stroke='#E8EFF8' strokeWidth='1' />
                <line x1='110' y1='40' x2='110' y2='260' stroke='#3D7BD9' strokeWidth='2' />
                <line x1='110' y1='260' x2='640' y2='260' stroke='#3D7BD9' strokeWidth='2' />
                <line x1='110' y1='52' x2='620' y2='52' stroke='#1E4FA8' strokeWidth='1.5' strokeDasharray='6 5' />
                <line x1='110' y1='228' x2='620' y2='228' stroke='#0E3F8C' strokeWidth='1.5' strokeDasharray='6 5' />
                <polyline points='110,52 152.5,53.7 195,58.9 237.5,67.4 280,79.2 322.5,93.8 365,111.2 407.5,130.8 450,152.4 492.5,175.1 535,197.9 577.5,218.2 620,228' fill='none' stroke='#1E4FA8' strokeWidth='4' strokeLinejoin='round' />
                <circle cx='110' cy='52' r='6' fill='#1E4FA8' />
                <circle cx='620' cy='228' r='6' fill='#0E3F8C' />
                <text x='120' y='44' fill='#1E4FA8' fontSize='17' fontWeight='bold' fontFamily='Times New Roman'>r = 0.52（θ₂ = 0°，伸得最远）</text>
                <text x='470' y='248' fill='#0E3F8C' fontSize='17' fontWeight='bold' fontFamily='Times New Roman'>r = 0.08（θ₂ = 180°，缩得最短）</text>
                <text x='110' y='278' textAnchor='middle' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>0°</text>
                <text x='195' y='278' textAnchor='middle' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>30°</text>
                <text x='280' y='278' textAnchor='middle' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>60°</text>
                <text x='365' y='278' textAnchor='middle' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>90°</text>
                <text x='450' y='278' textAnchor='middle' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>120°</text>
                <text x='535' y='278' textAnchor='middle' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>150°</text>
                <text x='620' y='278' textAnchor='middle' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>180°</text>
                <text x='96' y='220' textAnchor='end' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>0.1</text>
                <text x='96' y='140' textAnchor='end' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>0.3</text>
                <text x='96' y='60' textAnchor='end' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>0.5</text>
                <text x='96' y='270' textAnchor='end' fill='#1A2230' fontSize='14' fontFamily='Microsoft YaHei' opacity='0.7'>r /m</text>
                <text x='646' y='266' fill='#1A2230' fontSize='14' fontFamily='Times New Roman'>θ₂</text>
            </svg>
        </Box>
        <Box style={{ height: 110, background: '#E8EFF8', padding: 18, display: 'flex', flexDirection: 'row', gap: 20, alignItems: 'center' }}>
            <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>洞察：r 在 [0°, 180°] 上严格单调减小</Text>
                <Text style={{ fontSize: 15, color: '#1A2230', opacity: 0.8, lineHeight: 1.65 }}>第二段先“绕出去”再“收回来”，所以曲线是光滑下滑、没有回升。</Text>
            </Box>
            <Box style={{ width: 430, background: '#0E3F8C', padding: 14, display: 'flex', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 15, color: '#CFE0F5', lineHeight: 1.6 }}>关键结论：r 只取决于 θ₂ —— 把 θ₁ 改成 90° 再做一次，r 的曲线一模一样。</Text>
            </Box>
        </Box>
        <Table
            style={{ width: '100%', height: 96 }}
            defaultTextStyle={{ fontSize: 14, textAlign: 'center', color: '#1A2230' }}
            defaultCellStyle={{ border: { left: { width: 1, color: '#E8EFF8' }, right: { width: 1, color: '#E8EFF8' }, top: { width: 1, color: '#E8EFF8' }, bottom: { width: 1, color: '#E8EFF8' } } }}
            cells={[
                [
                    { text: '六个可手算的校验点', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '(0°, 0°)', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '(0°, 90°)', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '(90°, 0°)', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '(90°, −90°)', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '(35°, 60°)', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '(0°, 180°)', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } }
                ],
                [
                    { text: '末端 (x, y) / m', cellStyle: { background: { color: '#E8EFF8' } } },
                    { text: '(0.5200, 0.0000)', textStyle: { fontFamily: 'Times New Roman' } },
                    { text: '(0.3000, 0.2200)', textStyle: { fontFamily: 'Times New Roman' } },
                    { text: '(0.0000, 0.5200)', textStyle: { fontFamily: 'Times New Roman' } },
                    { text: '(0.2200, 0.3000)', textStyle: { fontFamily: 'Times New Roman' } },
                    { text: '(0.2266, 0.3912)', textStyle: { fontFamily: 'Times New Roman' } },
                    { text: '(0.0800, 0.0000)', textStyle: { fontFamily: 'Times New Roman' } }
                ]
            ]}
        />
    </Box>
    <Box style={{ height: 44, display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#1A2230', opacity: 0.5 }}>第 3 章 · M3　平面正运动学：1R → 2R → 3R</Text>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0E3F8C', fontFamily: 'Times New Roman' }}>19 / 21</Text>
    </Box>
</Slide>
