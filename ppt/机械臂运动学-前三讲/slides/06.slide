<Slide style={{ width: 1280, height: 720, padding: 0, display: 'flex', flexDirection: 'column', background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ height: 76, background: '#1E4FA8', display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>两台真实机械臂：一台“乖”、一台“多一只手”</Text>
        <Text style={{ fontSize: 15, color: '#CFE0F5' }}>M1 · 实物对照</Text>
    </Box>
    <Box style={{ height: 12 }} />
    <Box style={{ flex: 1, paddingLeft: 40, paddingRight: 40, display: 'flex', flexDirection: 'column', gap: 12 }}>
        <Box style={{ height: 44, background: '#E8EFF8', display: 'flex', alignItems: 'center', paddingLeft: 20 }}>
            <Text style={{ fontSize: 17, color: '#0E3F8C', fontWeight: 'bold' }}>先看数据：两台机器的规格差异，直接决定了后面公式的难度</Text>
        </Box>
        <Table
            style={{ width: '100%', height: 336 }}
            defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#1A2230' }}
            defaultCellStyle={{ border: { left: { width: 1, color: '#E8EFF8' }, right: { width: 1, color: '#E8EFF8' }, top: { width: 1, color: '#E8EFF8' }, bottom: { width: 1, color: '#E8EFF8' } } }}
            cells={[
                [
                    { text: '项目', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: 'UR5（主力机型）', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '宇树 R1 机械臂（对照机型）', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } }
                ],
                ['出身', '丹麦 Universal Robots · 经典工业协作臂', '杭州宇树科技 · 人形机器人 R1 的机械臂'],
                [{ text: '自由度', cellStyle: { background: { color: '#E8EFF8' } } }, { text: '6', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#E8EFF8' } } }, { text: '7', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#E8EFF8' } } }],
                ['负载 / 自重', '5 kg / 18.4 kg', '2 kg / 5.5 kg'],
                [{ text: '名义工作半径', cellStyle: { background: { color: '#E8EFF8' } } }, { text: '850 mm', cellStyle: { background: { color: '#E8EFF8' } } }, { text: '约 650 mm', cellStyle: { background: { color: '#E8EFF8' } } }],
                ['重复定位精度', '±0.1 mm', '—'],
                [{ text: '关节轴排布', cellStyle: { background: { color: '#E8EFF8' } } }, { text: '6 个关节全部绕自身 z 轴（z z z z z z）', cellStyle: { background: { color: '#E8EFF8' } } }, { text: '混合（-z x y x y -x -z）', cellStyle: { background: { color: '#E8EFF8' } } }],
                ['末端参考系', 'tool0（法兰中心）', 'Link7']
            ]}
        />
        <Box style={{ flex: 1, display: 'flex', flexDirection: 'row', gap: 14 }}>
            <Box style={{ flex: 1, background: '#E8EFF8', padding: 18, display: 'flex', flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0E3F8C' }}>判断：自由度多一个 ≠ 更强</Text>
                <Text style={{ fontSize: 15, color: '#1A2230', opacity: 0.78, lineHeight: 1.6 }}>多出来的那 1 个自由度，换来的是“同一个目标有多种姿势可选”，代价是解空间更难算。</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E8EFF8', padding: 18, display: 'flex', flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0E3F8C' }}>反直觉伏笔（M10 揭开）</Text>
                <Text style={{ fontSize: 15, color: '#1A2230', opacity: 0.78, lineHeight: 1.6 }}>实测：UR5 最后三轴并<span style={{ fontWeight: 'bold' }}>不</span>交于一点（轴 4 与轴 6 平行，相距 94.65 mm）；R1 反而近似交于一点（偏差 5.0 mm）。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 44, display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#1A2230', opacity: 0.5 }}>第 1 章 · M1　机械臂怎么“知道”手在哪？</Text>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0E3F8C', fontFamily: 'Times New Roman' }}>06 / 21</Text>
    </Box>
</Slide>
